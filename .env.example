# Environment Configuration for Recovery Tool

# Backend API Configuration
# API endpoint for premium verification
API_BASE_URL=https://api.example.com
API_TIMEOUT=30

# macOS Notarization Configuration
# Apple ID (email)
APPLE_ID=your-apple-id@example.com
# Apple Team ID (10-character alphanumeric string)
APPLE_TEAM_ID=XXXXXXXXXX
# App-Specific Password (created at appleid.apple.com)
APPLE_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Keychain profile name for notarytool
NOTARY_PROFILE=notary-profile
